# Copie para .env (na pasta do NAS) e preencha. O .env nunca vai para o GitHub.

# Endereços públicos deste app (Cloudflare e DuckDNS). Cadastre os dois no Google Cloud como
# URI de redirecionamento: <endereço>/auth/google/callback
PUBLIC_URL=https://aquecimento.nas2800.com,https://aquecimento.nas2800.duckdns.org

# Login Google: os mesmos do .env do Hub/Cofre. Quem pode entrar: e-mails separados por vírgula.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=

# Login único com o Hub: o mesmo SSO_SECRET (32+ caracteres) do .env do Hub.
SSO_SECRET=
HUB_URL=https://hub.nas2800.com

# AdsPower no PC (ponte tools/pc-bridge.js): http://IP-DO-PC:50326 e o token definido lá.
# Estes valores são só o inicial: na tela (Configurações › Conexões) você troca URL, chave e token quando mudar de computador.
ADSPOWER_URL=http://192.168.0.10:50326
ADSPOWER_BRIDGE_TOKEN=

# Cofre de Ativos (só leitura).
COFRE_URL=https://ativos.nas2800.com
COFRE_API_KEY=

# 0 = desliga a senha local (só Google/Hub). Deixe vazio enquanto testa.
PASSWORD_LOGIN=
